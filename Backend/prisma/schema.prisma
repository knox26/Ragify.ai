generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

enum UploadStatus {
  PENDING_UPLOAD
  UPLOAD_COMPLETED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum DocumentFailureReason {
  PASSWORD_PROTECTED
  CORRUPTED_FILE
  EMPTY_DOCUMENT
  OCR_REQUIRED
  EMBEDDING_FAILED
  PROCESSING_FAILED
}

enum ChatRole {
  USER
  ASSISTANT
}

// prisma/schema.prisma

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  passwordHash  String
  tokenVersion  Int      @default(0)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relational Arrays
  refreshTokens RefreshToken[]
  documents     Document[]
  chatSessions  ChatSession[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, expiresAt])
}

model Document {
  id       String  @id @default(uuid())
  fileName String
  fileSize BigInt
  mimeType String
  r2Key    String  @unique
  uploadId String?

  status UploadStatus @default(PENDING_UPLOAD)

  // Phase 2 re-ingest idempotency (Option B): SHA-256 of the normalized
  // document text + chunker version. Re-ingest with a matching hash is a
  // no-op; null means "never hashed" (pre-Phase-2) → re-ingest once.
  contentHash String?

  failureReason DocumentFailureReason?
  errorMessage  String?                @db.Text

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, createdAt, id])
  @@index([status])
  @@index([fileName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Document_fileName_trgm_idx")

  chatSessions ChatSession[]
}

model ChatSession {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId String? // null = global chat, set = doc-scoped
  document   Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  title      String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  messages   ChatMessage[]

  @@index([userId, updatedAt, id])
  @@index([documentId])
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      ChatRole
  content   String      @db.Text
  sources   Json? // ChatSourcePayload[] — null when none
  error     Boolean     @default(false) // true when assistant msg truncated by mid-stream failure
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt, id])
}
